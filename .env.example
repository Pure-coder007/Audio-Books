# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
DATABASE_URL=sqlite:///myaudioshelf.db
BASE_URL=http://127.0.0.1:5000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=MyAudioShelf <hello@example.com>
MAIL_USE_TLS=true
# Required for multiple production workers (e.g. redis://localhost:6379/0)
RATELIMIT_STORAGE_URI=memory://
# Development only. Explicitly displays sandbox checkout; never takes payments.
DEMO_MODE=true
